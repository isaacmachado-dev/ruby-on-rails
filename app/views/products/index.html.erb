<%# app/views/products/index.html.erb %>
<h1>Products</h1>
<h2><%= t ".title" %></h2>
<h1><%= t "hello" %></h1>d3

<%# Só aparece New Product if autenticado(logado) %>
<%= link_to "New Product", new_product_path if authenticated? %>

<div id="products">
  <% @products.each do |product| %>
    <div>
      <%= link_to product.name, product_path(product.id) %>
    </div>
  <% end %>
</div>

<h1>Stimulus study </h1>

<div data-controller="stimulus">
  <input  data-stimulus-target="name" type="text" autocomplete="off">
  <button data-action="click->stimulus#greet">Greet</button>
</div>

<div data-controller="clipboard">
  PIN: <input data-clipboard-target="source" type="text" value="1234" v-model="pin" readonly autocomplete="off" data-clipboard-supported-class="cllipboard--suported">
  <button data-action="clipboard#copy">Copy to clipboard</button>
</div>

<div data-controller="clipboard">
  PIN: <input data-clipboard-target="source" type="text" value="4321" v-model="pin" readonly autocomplete="off" data-clipboard-supported-class="cllipboard--suported">
  <button data-action="clipboard#copy">Copy to clipboard</button>
</div>

<div data-controller="clipboard">
  PIN: <input data-clipboard-target="source" type="text" value="5678" readonly autocomplete="off" data-clipboard-supported-class="cllipboard--suported">
  <a href="#TestClipboardLink" data-action="clipboard#copy">Copy to Clipboard</a>
</div>

PIN: <textarea data-clipboard-target="source" readonly>9876</textarea>

<div>
  <div data-controller="slideshow" data-slideshow-index-value="1">
    <button data-action="slideshow#previous"><-</button>
    <button data-action="slideshow#next">-></button>

    <div data-slideshow-target="slide">😨</div>
    <div data-slideshow-target="slide">😱</div>
    <div data-slideshow-target="slide">😰</div>
    <div data-slideshow-target="slide">😓</div>
    <div data-slideshow-target="slide">😥</div>
    <div data-slideshow-target="slide">😭</div>

  </div>
</div>


<!-- Assynchronous Loading HTML -->

<div>
  <div data-controller="content-loader">
    <a href="#" data-content-loader-url-param="/messages.html"
                data-action="click->content-loader#load">Messages</a>

    <a href="#" data-content-loader-url-param="/comments.html"
                data-action="click->content-loader#load">Comments</a>
  </div>
</div>
